# 正式網址：安裝指令、registry URL 與 metadata 都用它
NEXT_PUBLIC_SITE_URL=https://sunui.synvize.com

# Polar：Pro registry 驗證授權碼用（organization_id 在 Polar 設定頁）
POLAR_ORGANIZATION_ID=
# 測試時改成 https://sandbox-api.polar.sh
POLAR_API_URL=https://api.polar.sh

# Polar 結帳連結；未設定時定價頁會改顯示 waitlist
NEXT_PUBLIC_CHECKOUT_FOUNDING_URL=
NEXT_PUBLIC_CHECKOUT_PRO_URL=
NEXT_PUBLIC_CHECKOUT_TEAM_URL=

# Resend：waitlist 名單（未設定時，本機開發會寫到 .data/waitlist.jsonl）
RESEND_API_KEY=
RESEND_WAITLIST_SEGMENT_ID=

# 本機開發用的測試授權碼（逗號分隔），正式環境一律忽略
SUNUI_DEV_LICENSE_KEYS=

# Upstash Redis（Vercel Marketplace 的 KV_REST_API_URL / KV_REST_API_TOKEN 也可）：免費 registry 匿名安裝計數
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 讀取 /api/installs 排行用的權杖（自己產生一串亂碼）
SUNUI_STATS_TOKEN=
