# 正式網址：安裝指令、registry URL 與 metadata 都用它
NEXT_PUBLIC_SITE_URL=https://sunui.synvize.com

# SHOPLINE Payments：Pro 收款（新台幣，導轉式結帳）。三個都設定才會開放結帳，否則定價頁顯示 waitlist
# 商家 ID 與 API key 和作者其他產品共用同一個商家帳號；Sign Key 是 SunUI 這一列 webhook 專屬的
# webhook 端點：<site>/api/shopline/webhook，勾選 trade.succeeded、trade.failed、trade.expired、trade.refund.succeeded、dispute.*
SHOPLINE_MERCHANT_ID=
SHOPLINE_API_KEY=
SHOPLINE_SIGN_KEY=
# live 走正式環境，其他值走 sandbox；本機設 dev 會跳過 SHOPLINE 直接入帳（正式環境一律忽略 dev）
SHOPLINE_ENV=sandbox

# Upstash Redis（Vercel Marketplace 的 KV_REST_API_URL / KV_REST_API_TOKEN 也可）：
# 訂單、授權碼、免費安裝與漏斗計數。結帳與 Pro 驗證都需要它
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 讀取 /api/installs 排行用的權杖（自己產生一串亂碼）
SUNUI_STATS_TOKEN=
# IP 雜湊的鹽值（自己產生一串亂碼），Redis 只存雜湊後的 IP
SUNUI_HASH_SALT=

# Resend：waitlist 名單、授權碼信、新訂單通知、後台登入信（未設定時，本機開發的 waitlist 會寫到 .data/waitlist.jsonl）
RESEND_API_KEY=
RESEND_WAITLIST_SEGMENT_ID=
# 寄件人，例如 SunUI <hello@synvize.com>（網域要先在 Resend 驗證）。
# 留空時用 onboarding@resend.dev，它只能寄給 Resend 帳號本人：買家會收不到授權碼信（完成頁仍會顯示）
RESEND_FROM=

# 本機開發用的測試授權碼（逗號分隔），正式環境一律忽略
SUNUI_DEV_LICENSE_KEYS=

# /admin 後台（docs: reports/Admin 統計系統規劃-2026-11-13.md）
# 主密鑰，至少 16 字元：openssl rand -hex 24。簽登入狀態、登入連結，也用來加密完成頁要顯示的授權碼。
# 未設定時 /admin 整個回 404。換掉它會讓所有人登出，舊訂單的完成頁也無法再顯示授權碼（授權本身照常有效）
SUNUI_ADMIN_TOKEN=
# 可以登入後台的帳號，逗號分隔（Google 登入與 email 登入連結都比對這份名單），也會收到新訂單通知
SUNUI_ADMIN_EMAILS=
# Google 登入：Google Cloud Console → 憑證 → OAuth 用戶端 ID（網頁應用程式），
# 「已授權的 JavaScript 來源」加 https://sunui.synvize.com 與 http://localhost:3112。不需要 client secret
GOOGLE_CLIENT_ID=
