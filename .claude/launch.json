{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@sunui-design/web"
      ],
      "port": 3100
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@sunui-design/web",
        "--",
        "-p",
        "3102"
      ],
      "port": 3102,
      "env": {
        "NEXT_DIST_DIR": ".next-alt"
      }
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build -w @sunui-design/web && npm run start -w @sunui-design/web -- -p ${PORT:-3101}"
      ],
      "port": 3101,
      "env": {
        "NEXT_DIST_DIR": ".next-prod"
      }
    }
  ]
}
