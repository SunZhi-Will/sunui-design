{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@sunui-design/web"
      ],
      "port": 3100
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@sunui-design/web",
        "--",
        "-p",
        "3102"
      ],
      "port": 3102,
      "env": {
        "NEXT_DIST_DIR": ".next-alt"
      }
    },
    {
      "name": "web-motion",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@sunui-design/web",
        "--",
        "-p",
        "3106"
      ],
      "port": 3106,
      "autoPort": false,
      "env": {
        "NEXT_DIST_DIR": ".next-motion"
      }
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build -w @sunui-design/web && npm run start -w @sunui-design/web -- -p ${PORT:-3101}"
      ],
      "port": 3101,
      "env": {
        "NEXT_DIST_DIR": ".next-prod"
      }
    },
    {
      "name": "web-pro-test",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run dev -w @sunui-design/web -- -p ${PORT:-3104}"
      ],
      "port": 3104,
      "autoPort": false,
      "env": {
        "NEXT_DIST_DIR": ".next-protest",
        "NEXT_PUBLIC_SITE_URL": "http://localhost:3104",
        "SUNUI_DEV_LICENSE_KEYS": "sunui-dev-test-key-0001"
      }
    },
    {
      "name": "web-mp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@sunui-design/web",
        "--",
        "-p",
        "3108"
      ],
      "port": 3108,
      "autoPort": false,
      "env": {
        "NEXT_DIST_DIR": ".next-mp"
      }
    },
    {
      "name": "web-alt-attach",
      "url": "http://localhost:3102",
      "port": 3102
    },
    {
      "name": "web-perf",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/web && npx next build --no-lint --experimental-build-mode=compile && npx next build --no-lint --experimental-build-mode=generate && npx next start -p 3110"
      ],
      "port": 3110,
      "autoPort": false,
      "env": {
        "NEXT_DIST_DIR": ".next-perf"
      }
    },
    {
      "name": "web-admin",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run dev -w @sunui-design/web -- -p ${PORT:-3112}"
      ],
      "port": 3112,
      "autoPort": false,
      "env": {
        "NEXT_DIST_DIR": ".next-admin",
        "NEXT_PUBLIC_SITE_URL": "http://localhost:3112",
        "SUNUI_DEV_LICENSE_KEYS": "sunui-dev-test-key-0001",
        "SUNUI_ADMIN_TOKEN": "local-dev-admin-token-only",
        "SUNUI_ADMIN_EMAILS": "owner@example.com",
        "GOOGLE_CLIENT_ID": "385022749974-54lnlukhs3f0024argdkhah4t046cice.apps.googleusercontent.com"
      }
    }
  ]
}
