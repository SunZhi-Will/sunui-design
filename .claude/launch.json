{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@sunui-design/web"
      ],
      "port": 3100
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@sunui-design/web", "--", "-p", "3102"],
      "port": 3102
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "@sunui-design/web",
        "--",
        "-p",
        "3101"
      ],
      "port": 3101
    }
  ]
}